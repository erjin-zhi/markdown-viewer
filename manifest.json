{
  "manifest_version": 3,
  "name": "Markdown Viewer · Markdown 预览",
  "version": "1.3.0",
  "description": "自动预览 Markdown 接口与文件，支持高亮、目录、临时编辑和保存文件。编辑仅本页有效，刷新即恢复原文。",
  "minimum_chrome_version": "128",
  "permissions": [
    "storage",
    "webRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Markdown Viewer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "markdown",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
